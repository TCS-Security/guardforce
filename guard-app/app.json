{
  "expo": {
    "name": "GuardForce",
    "slug": "guardforce-guard",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "guardforce",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#F9F7F3",
    "android": {
      "package": "com.guardforce.guard",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/images/adaptive-icon.png", "backgroundColor": "#375028" },
      "edgeToEdgeEnabled": true,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.NFC",
        "android.permission.CALL_PHONE"
      ],
      "intentFilters": [
        { "action": "VIEW", "data": [{ "scheme": "guardforce", "host": "invite" }], "category": ["BROWSABLE", "DEFAULT"] }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-localization",
      ["expo-splash-screen", { "image": "./assets/images/splash-icon.png", "imageWidth": 160, "backgroundColor": "#F9F7F3", "dark": { "backgroundColor": "#1D1711" } }],
      ["expo-font", { "fonts": ["./assets/fonts/bricolage_grotesque.ttf", "./assets/fonts/schibsted_grotesk.ttf", "./assets/fonts/jetbrains_mono.ttf"] }],
      ["expo-location", {
        "locationAlwaysAndWhenInUsePermission": "GuardForce records your location for the whole shift so it counts.",
        "isAndroidBackgroundLocationEnabled": true,
        "isAndroidForegroundServiceEnabled": true
      }],
      ["expo-camera", { "cameraPermission": "One selfie at shift start and end, plus patrol and task photos." }],
      ["expo-notifications", { "icon": "./assets/images/notification-icon.png", "color": "#375028" }],
      ["expo-local-authentication", { "faceIDPermission": "Unlock GuardForce" }],
      ["expo-build-properties", { "android": { "compileSdkVersion": 36, "targetSdkVersion": 36, "minSdkVersion": 26, "usesCleartextTraffic": true } }]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "supabaseUrl": "http://10.0.2.2:54321",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0",
      "otaChannel": "production",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.guardforce.guard"
    }
  }
}
